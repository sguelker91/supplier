# Beispiel-Umgebungsvariablen für apps/api.
# Kopieren nach `.env` (nicht einchecken) und mit echten Werten befüllen.
#
# ACHTUNG: `ZITADEL_ISSUER` unten ist der in ADR 0004 ("Implementierungsnotizen")
# bereits dokumentierte, nicht-geheime Issuer der ZITADEL-Projektinstanz.
# `ZITADEL_AUDIENCE` (die erwartete Client-/Ressourcen-ID für apps/api selbst)
# ist laut ADR 0004 NICHT dokumentiert/entschieden -- kein Platzhalter-Wert
# wird hier erfunden. Ohne gesetzten Wert verweigert apps/api den Start
# (siehe src/auth/auth.config.ts), damit keine stillschweigende
# Fehlkonfiguration entsteht.

PORT=3000

# ZITADEL-Instanz-URL (Issuer). Quelle: ADR 0004, Implementierungsnotizen.
ZITADEL_ISSUER=https://supplier-janwkz.eu1.zitadel.cloud

# Erwartete Audience (Client-/API-Ressourcen-ID von apps/api in ZITADEL).
# Muss pro Umgebung real konfiguriert werden -- siehe ADR 0004, "Offene Annahmen".
ZITADEL_AUDIENCE=

# Optional: abweichender JWKS-Endpoint, falls nicht "<issuer>/oauth/v2/keys".
# ZITADEL_JWKS_URI=
